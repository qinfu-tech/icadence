# Only explicitly approved product documentation and assets are public.
*
!.gitignore
!README.md
!README.zh-CN.md
!CHANGELOG.md
!docs/
docs/*
!docs/en/
!docs/zh-CN/
docs/en/*
docs/zh-CN/*
!docs/en/faq.md
!docs/zh-CN/faq.md
!assets/
assets/*
!assets/icon.png
!assets/README.md
!assets/screenshots/
assets/screenshots/*
!assets/screenshots/en/
!assets/screenshots/zh-CN/
assets/screenshots/en/*
assets/screenshots/zh-CN/*
!assets/screenshots/en/today.png
!assets/screenshots/en/walking.png
!assets/screenshots/en/routine.png
!assets/screenshots/zh-CN/today.png
!assets/screenshots/zh-CN/walking.png
!assets/screenshots/zh-CN/routine.png
